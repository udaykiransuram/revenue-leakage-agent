# Set secrets in the Vercel project settings. Never commit their values.
DATABASE_URL=
# Direct connection for idempotent schema setup at container startup.
DATABASE_URL_UNPOOLED=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
OPENROUTER_BACKUP_MODEL=openrouter/free
AGENT_MODE=live
MODEL_PROVIDER=groq
DATASET_MODE=challenge
PERSISTENCE_BACKEND=postgres
REVENUE_WORKSPACE=revenue-leakage
OPENROUTER_BACKUP_ENABLED=true
OLLAMA_BACKUP_ENABLED=false
LANGSMITH_TRACING=false
PORT=80
