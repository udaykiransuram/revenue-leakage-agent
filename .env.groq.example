# Use a Groq Free Plan account. Do not enable paid billing for this demo.
# Free-plan limits are account-specific. Try the configured fallback on HTTP 429 or transient failures.
AGENT_MODE=live
MODEL_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
GROQ_API_KEY=
LANGSMITH_TRACING=false

DATASET_MODE=challenge

# Optional final backup after Groq; add a separate OpenRouter key locally.
OPENROUTER_BACKUP_ENABLED=true
OPENROUTER_BACKUP_MODEL=openrouter/free
OPENROUTER_API_KEY=

# Optional final local backup; model must already be installed in Ollama.
OLLAMA_BACKUP_ENABLED=true
OLLAMA_BACKUP_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_BACKUP_NUM_CTX=32768
OLLAMA_BACKUP_TIMEOUT_SECONDS=120
